      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Inter:wght@100..900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --rose-deep: #c25e7c;\n    --rose-light: #e8a4b8;\n    --peach: #ffc9de;\n    --ink-black: #1a0f14;\n    --pink-cream: #fff5f7;\n    --glass-bg: rgba(255, 248, 250, 0.85);\n    --glass-border: rgba(255, 255, 255, 0.6);\n  }\n\n  .font-heading { font-family: 'Bodoni Moda', serif; }\n  .font-body { font-family: 'Inter', sans-serif; }\n\n  /* Custom scrollbar for luxury feel */\n  .custom-scroll::-webkit-scrollbar {\n    width: 3px;\n  }\n  .custom-scroll::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  .custom-scroll::-webkit-scrollbar-thumb {\n    background: linear-gradient(to bottom, transparent, var(--rose-light), transparent);\n    border-radius: 10px;\n  }\n\n  .glass-panel {\n    background: var(--glass-bg);\n    backdrop-filter: blur(32px);\n    -webkit-backdrop-filter: blur(32px);\n    border-left: 1px solid var(--glass-border);\n  }\n\n  .checkout-btn-gradient {\n    background: linear-gradient(135deg, #c25e7c 0%, #e8a4b8 100%);\n    box-shadow: 0 12px 40px rgba(194, 94, 124, 0.35);\n  }\n\n  .checkout-btn-gradient:hover {\n    box-shadow: 0 18px 50px rgba(194, 94, 124, 0.5);\n    transform: translateY(-3px) scale(1.02);\n  }\n\n  .item-card-hover:hover {\n    background: white;\n    box-shadow: 0 15px 40px rgba(194, 94, 124, 0.08);\n    transform: translateX(-5px);\n  }\n\n  @keyframes float {\n    0%, 100% { transform: translateY(0px); }\n    50% { transform: translateY(-20px); }\n  }\n\n  .animate-float {\n    animation: float 8s ease-in-out infinite;\n  }\n</style>\n\n\n<div class=\"relative w-full h-[900px] bg-[#FFF5F7] overflow-hidden\" data-kid=\"1\">\n  \n  \n  <div class=\"absolute inset-0 z-0\" data-kid=\"1-0\">\n    \n    <div class=\"absolute top-[-10%] left-[-5%] w-[600px] h-[600px] bg-[#FFC9DE]/30 rounded-full blur-[100px] animate-pulse\" data-kid=\"1-0-0\"></div>\n    <div class=\"absolute bottom-[5%] left-[15%] w-[400px] h-[400px] bg-[#F9C5B8]/20 rounded-full blur-[80px] animate-float\" style=\"animation-delay: 2s;\" data-kid=\"1-0-1\"></div>\n    \n    \n    <img src=\"https://images.unsplash.com/photo-1770457732642-505ffd11c062?auto=format&w=1440&q=40&fit=crop\" class=\"w-full h-full object-cover opacity-15 mix-blend-multiply pointer-events-none\" alt=\"texture\" decoding=\"async\" loading=\"lazy\" data-kid=\"1-0-2\">\n    \n    \n    <div class=\"absolute inset-0 p-20 opacity-30 pointer-events-none\" data-kid=\"1-0-3\">\n      <div class=\"max-w-4xl mx-auto space-y-12\" data-kid=\"1-0-3-0\">\n        <h1 class=\"font-heading text-8xl text-[#1a0f14] italic\" data-kid=\"1-0-3-0-0\">The Art of Writing</h1>\n        <div class=\"grid grid-cols-2 gap-10\" data-kid=\"1-0-3-0-1\">\n          <div class=\"h-80 bg-white/40 rounded-3xl\" data-kid=\"1-0-3-0-1-0\"></div>\n          <div class=\"h-80 bg-white/40 rounded-3xl\" data-kid=\"1-0-3-0-1-1\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n  <div id=\"cartOverlay\" class=\"absolute inset-0 bg-[#1A0F14]/20 backdrop-blur-sm z-[9998]\" data-kid=\"1-1\"></div>\n\n  \n  <div id=\"cartSidebar\" class=\"absolute top-0 right-0 h-full w-[460px] glass-panel z-[9999] flex flex-col shadow-[-30px_0_80px_rgba(26,15,20,0.12)]\" data-kid=\"1-2\">\n    \n    \n    <div class=\"px-10 py-12 border-b border-[#c25e7c]/10 flex items-center justify-between\" data-kid=\"1-2-0\">\n      <div class=\"flex items-center gap-6\" data-kid=\"1-2-0-0\">\n        <div class=\"relative flex items-center justify-center w-16 h-16 bg-white rounded-3xl shadow-sm rotate-3 border border-[#c25e7c]/5\" data-kid=\"1-2-0-0-0\">\n          <i class=\"ti ti-shopping-bag text-3xl text-[#c25e7c]\" data-kid=\"1-2-0-0-0-0\"></i>\n          <span class=\"absolute -top-2 -right-2 w-7 h-7 bg-[#c25e7c] text-white text-[11px] font-black rounded-full flex items-center justify-center border-4 border-white shadow-md\" data-kid=\"1-2-0-0-0-1\">3</span>\n        </div>\n        <div data-kid=\"1-2-0-0-1\">\n          <h2 class=\"font-heading text-4xl font-bold text-[#1a0f14] tracking-tight\" data-kid=\"1-2-0-0-1-0\">Your Cart</h2>\n          <p class=\"font-body text-[10px] uppercase tracking-[0.3em] font-black text-[#c25e7c] mt-1.5 opacity-60\" data-kid=\"1-2-0-0-1-1\">Exquisite Selection</p>\n        </div>\n      </div>\n      <button class=\"w-12 h-12 rounded-full flex items-center justify-center bg-white/50 border border-white hover:bg-white hover:scale-110 transition-all duration-300 shadow-sm cursor-pointer group\" data-kid=\"1-2-0-1\">\n        <i class=\"ti ti-x text-xl text-[#1a0f14] group-hover:rotate-90 transition-transform duration-300\" data-kid=\"1-2-0-1-0\"></i>\n      </button>\n    </div>\n\n    \n    <div class=\"flex-1 overflow-y-auto px-8 py-8 space-y-6 custom-scroll\" data-kid=\"1-2-1\">\n      \n      \n      <div class=\"group item-card-hover flex gap-5 p-5 bg-white/60 rounded-[32px] border border-white transition-all duration-500 shadow-sm\" data-kid=\"1-2-1-0\">\n        <div class=\"relative w-28 h-28 rounded-2xl overflow-hidden bg-gradient-to-br from-[#ffc9de] to-[#fff5f7] border border-[#c25e7c]/10 flex-shrink-0\" data-kid=\"1-2-1-0-0\">\n          <img src=\"https://images.unsplash.com/photo-1513666639414-f795d25747a8?auto=format&w=200&q=80&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" alt=\"Eternal Gold Fountain\" decoding=\"async\" loading=\"lazy\" data-kid=\"1-2-1-0-0-0\">\n          <div class=\"absolute inset-0 bg-gradient-to-t from-[#c25e7c]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"1-2-1-0-0-1\"></div>\n        </div>\n        <div class=\"flex-1 flex flex-col justify-between py-1\" data-kid=\"1-2-1-0-1\">\n          <div class=\"flex justify-between items-start\" data-kid=\"1-2-1-0-1-0\">\n            <div class=\"max-w-[160px]\" data-kid=\"1-2-1-0-1-0-0\">\n              <h4 class=\"font-heading text-xl font-bold text-[#1a0f14] leading-tight truncate group-hover:text-[#c25e7c] transition-colors\" data-kid=\"1-2-1-0-1-0-0-0\">Eternal Gold</h4>\n              <p class=\"font-body text-[10px] text-[#c25e7c] font-black tracking-[0.15em] mt-1 opacity-60\" data-kid=\"1-2-1-0-1-0-0-1\">FOUNTAIN PEN</p>\n            </div>\n            <button class=\"w-9 h-9 flex items-center justify-center text-[#1a0f14]/15 hover:text-red-500 hover:bg-red-50 rounded-full transition-all cursor-pointer\" data-kid=\"1-2-1-0-1-0-1\">\n              <i class=\"ti ti-trash text-xl\" data-kid=\"1-2-1-0-1-0-1-0\"></i>\n            </button>\n          </div>\n          <div class=\"flex justify-between items-center\" data-kid=\"1-2-1-0-1-1\">\n            <span class=\"font-heading text-2xl font-black text-[#c25e7c] tracking-tight\" data-kid=\"1-2-1-0-1-1-0\">$249</span>\n            <div class=\"flex items-center bg-white/90 rounded-full border border-[#c25e7c]/10 p-1.5 gap-4 shadow-sm\" data-kid=\"1-2-1-0-1-1-1\">\n              <button class=\"w-7 h-7 rounded-full flex items-center justify-center text-[#c25e7c] hover:bg-[#c25e7c] hover:text-white transition-all cursor-pointer\" data-kid=\"1-2-1-0-1-1-1-0\">\n                <i class=\"ti ti-minus text-xs\" data-kid=\"1-2-1-0-1-1-1-0-0\"></i>\n              </button>\n              <span class=\"font-body font-black text-xs text-[#1a0f14] w-4 text-center\" data-kid=\"1-2-1-0-1-1-1-1\">1</span>\n              <button class=\"w-7 h-7 rounded-full flex items-center justify-center text-[#c25e7c] hover:bg-[#c25e7c] hover:text-white transition-all cursor-pointer\" data-kid=\"1-2-1-0-1-1-1-2\">\n                <i class=\"ti ti-plus text-xs\" data-kid=\"1-2-1-0-1-1-1-2-0\"></i>\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"group item-card-hover flex gap-5 p-5 bg-white/50 rounded-[32px] border border-white/60 transition-all duration-500\" data-kid=\"1-2-1-1\">\n        <div class=\"relative w-28 h-28 rounded-2xl overflow-hidden bg-gradient-to-br from-[#ffc9de] to-[#fff5f7] border border-[#c25e7c]/5 flex-shrink-0\" data-kid=\"1-2-1-1-0\">\n          <img src=\"https://images.unsplash.com/photo-1672866939730-066e2daaac58?auto=format&w=200&q=80&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-115\" alt=\"Rose Quartz Journal\" decoding=\"async\" loading=\"lazy\" data-kid=\"1-2-1-1-0-0\">\n          <div class=\"absolute inset-0 bg-gradient-to-t from-[#c25e7c]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"1-2-1-1-0-1\"></div>\n        </div>\n        <div class=\"flex-1 flex flex-col justify-between py-1\" data-kid=\"1-2-1-1-1\">\n          <div class=\"flex justify-between items-start\" data-kid=\"1-2-1-1-1-0\">\n            <div class=\"max-w-[160px]\" data-kid=\"1-2-1-1-1-0-0\">\n              <h4 class=\"font-heading text-xl font-bold text-[#1a0f14] leading-tight truncate\" data-kid=\"1-2-1-1-1-0-0-0\">Quartz Journal</h4>\n              <p class=\"font-body text-[10px] text-[#c25e7c]/70 font-bold tracking-widest mt-1\" data-kid=\"1-2-1-1-1-0-0-1\">HAND-BOUND</p>\n            </div>\n            <button class=\"w-8 h-8 flex items-center justify-center text-[#1a0f14]/20 hover:text-red-500 hover:bg-red-50 rounded-full transition-all\" data-kid=\"1-2-1-1-1-0-1\">\n              <i class=\"ti ti-trash text-lg\" data-kid=\"1-2-1-1-1-0-1-0\"></i>\n            </button>\n          </div>\n          <div class=\"flex justify-between items-center\" data-kid=\"1-2-1-1-1-1\">\n            <span class=\"font-heading text-2xl font-black text-[#c25e7c] tracking-tight\" data-kid=\"1-2-1-1-1-1-0\">$85</span>\n            <div class=\"flex items-center bg-white/90 rounded-full border border-[#c25e7c]/10 p-1.5 gap-4 shadow-sm\" data-kid=\"1-2-1-1-1-1-1\">\n              <button class=\"w-7 h-7 rounded-full flex items-center justify-center text-[#c25e7c] hover:bg-[#c25e7c] hover:text-white transition-all cursor-pointer\" data-kid=\"1-2-1-1-1-1-1-0\">\n                <i class=\"ti ti-minus text-xs\" data-kid=\"1-2-1-1-1-1-1-0-0\"></i>\n              </button>\n              <span class=\"font-body font-black text-xs text-[#1a0f14] w-4 text-center\" data-kid=\"1-2-1-1-1-1-1-1\">1</span>\n              <button class=\"w-7 h-7 rounded-full flex items-center justify-center text-[#c25e7c] hover:bg-[#c25e7c] hover:text-white transition-all cursor-pointer\" data-kid=\"1-2-1-1-1-1-1-2\">\n                <i class=\"ti ti-plus text-xs\" data-kid=\"1-2-1-1-1-1-1-2-0\"></i>\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"group item-card-hover flex gap-5 p-5 bg-white/50 rounded-[32px] border border-white/60 transition-all duration-500\" data-kid=\"1-2-1-2\">\n        <div class=\"relative w-28 h-28 rounded-2xl overflow-hidden bg-gradient-to-br from-[#ffc9de] to-[#fff5f7] border border-[#c25e7c]/5 flex-shrink-0\" data-kid=\"1-2-1-2-0\">\n          <img src=\"https://images.pexels.com/photos/101539/fountain-pens-fountain-pen-filler-ink-101539.jpeg?auto=compress&cs=tinysrgb&w=200&q=80\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-115\" alt=\"Midnight Ink Set\" decoding=\"async\" loading=\"lazy\" data-kid=\"1-2-1-2-0-0\">\n          <div class=\"absolute inset-0 bg-gradient-to-t from-[#c25e7c]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"1-2-1-2-0-1\"></div>\n        </div>\n        <div class=\"flex-1 flex flex-col justify-between py-1\" data-kid=\"1-2-1-2-1\">\n          <div class=\"flex justify-between items-start\" data-kid=\"1-2-1-2-1-0\">\n            <div class=\"max-w-[160px]\" data-kid=\"1-2-1-2-1-0-0\">\n              <h4 class=\"font-heading text-xl font-bold text-[#1a0f14] leading-tight truncate\" data-kid=\"1-2-1-2-1-0-0-0\">Noir Pigment</h4>\n              <p class=\"font-body text-[10px] text-[#c25e7c]/70 font-bold tracking-widest mt-1\" data-kid=\"1-2-1-2-1-0-0-1\">INK COLLECTION</p>\n            </div>\n            <button class=\"w-8 h-8 flex items-center justify-center text-[#1a0f14]/20 hover:text-red-500 hover:bg-red-50 rounded-full transition-all\" data-kid=\"1-2-1-2-1-0-1\">\n              <i class=\"ti ti-trash text-lg\" data-kid=\"1-2-1-2-1-0-1-0\"></i>\n            </button>\n          </div>\n          <div class=\"flex justify-between items-center\" data-kid=\"1-2-1-2-1-1\">\n            <span class=\"font-heading text-2xl font-black text-[#c25e7c] tracking-tight\" data-kid=\"1-2-1-2-1-1-0\">$42</span>\n            <div class=\"flex items-center bg-white/90 rounded-full border border-[#c25e7c]/10 p-1.5 gap-4 shadow-sm\" data-kid=\"1-2-1-2-1-1-1\">\n              <button class=\"w-7 h-7 rounded-full flex items-center justify-center text-[#c25e7c] hover:bg-[#c25e7c] hover:text-white transition-all cursor-pointer\" data-kid=\"1-2-1-2-1-1-1-0\">\n                <i class=\"ti ti-minus text-xs\" data-kid=\"1-2-1-2-1-1-1-0-0\"></i>\n              </button>\n              <span class=\"font-body font-black text-xs text-[#1a0f14] w-4 text-center\" data-kid=\"1-2-1-2-1-1-1-1\">2</span>\n              <button class=\"w-7 h-7 rounded-full flex items-center justify-center text-[#c25e7c] hover:bg-[#c25e7c] hover:text-white transition-all cursor-pointer\" data-kid=\"1-2-1-2-1-1-1-2\">\n                <i class=\"ti ti-plus text-xs\" data-kid=\"1-2-1-2-1-1-1-2-0\"></i>\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    \n    <div class=\"px-10 pt-10 pb-12 bg-white/70 border-t border-white rounded-t-[60px] shadow-[0_-30px_80px_rgba(194,94,124,0.1)] relative overflow-hidden\" data-kid=\"1-2-2\">\n      \n      <div class=\"absolute -bottom-20 -right-20 w-80 h-80 bg-[#FFC9DE]/40 rounded-full blur-[80px] pointer-events-none\" data-kid=\"1-2-2-0\"></div>\n      \n      <div class=\"space-y-4 relative z-10\" data-kid=\"1-2-2-1\">\n        <div class=\"flex justify-between items-center\" data-kid=\"1-2-2-1-0\">\n          <span class=\"font-body text-sm font-semibold text-[#1a0f14]/40 uppercase tracking-widest\" data-kid=\"1-2-2-1-0-0\">Subtotal</span>\n          <span class=\"font-body text-sm font-black text-[#1a0f14] tracking-tight\" data-kid=\"1-2-2-1-0-1\">$418.00</span>\n        </div>\n        <div class=\"flex justify-between items-center\" data-kid=\"1-2-2-1-1\">\n          <span class=\"font-body text-sm font-semibold text-[#1a0f14]/40 uppercase tracking-widest\" data-kid=\"1-2-2-1-1-0\">Global Concierge</span>\n          <span class=\"font-body text-[10px] text-[#c25e7c] font-black uppercase tracking-[0.2em] italic bg-[#c25e7c]/5 px-3 py-1 rounded-full\" data-kid=\"1-2-2-1-1-1\">Complimentary</span>\n        </div>\n        \n        \n        <div class=\"relative h-px bg-gradient-to-r from-transparent via-[#c25e7c]/15 to-transparent my-6\" data-kid=\"1-2-2-1-2\"></div>\n\n        <div class=\"flex justify-between items-end mb-12\" data-kid=\"1-2-2-1-3\">\n          <div class=\"space-y-1\" data-kid=\"1-2-2-1-3-0\">\n            <span class=\"font-heading text-4xl font-bold text-[#1a0f14] tracking-tight\" data-kid=\"1-2-2-1-3-0-0\">Total</span>\n            <p class=\"text-[8px] uppercase tracking-[0.3em] text-[#c25e7c] font-black opacity-70\" data-kid=\"1-2-2-1-3-0-1\">Investment in elegance</p>\n          </div>\n          <div class=\"text-right pr-2\" data-kid=\"1-2-2-1-3-1\">\n            <span class=\"font-heading text-6xl font-black text-[#c25e7c] tracking-tighter leading-none\" data-kid=\"1-2-2-1-3-1-0\">$418.00</span>\n          </div>\n        </div>\n\n        <button class=\"w-full py-7 rounded-full checkout-btn-gradient text-white font-black text-xl tracking-[0.05em] transition-all duration-500 cursor-pointer flex items-center justify-center gap-5 group relative overflow-hidden\" data-kid=\"1-2-2-1-4\">\n          <span class=\"relative z-10\" data-kid=\"1-2-2-1-4-0\">PROCEED TO CHECKOUT</span>\n          <i class=\"ti ti-arrow-right text-2xl group-hover:translate-x-3 transition-transform duration-500 relative z-10\" data-kid=\"1-2-2-1-4-1\"></i>\n          \n          \n          <div class=\"absolute top-0 -left-[100%] w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent group-hover:left-[100%] transition-all duration-1000 ease-in-out\" data-kid=\"1-2-2-1-4-2\"></div>\n        </button>\n        \n        <div class=\"flex flex-col items-center gap-6 mt-8\" data-kid=\"1-2-2-1-5\">\n          <div class=\"flex items-center justify-center gap-10 opacity-40 grayscale hover:grayscale-0 transition-all duration-500\" data-kid=\"1-2-2-1-5-0\">\n            <i class=\"ti ti-brand-visa text-3xl\" data-kid=\"1-2-2-1-5-0-0\"></i>\n            <i class=\"ti ti-brand-mastercard text-3xl\" data-kid=\"1-2-2-1-5-0-1\"></i>\n            <i class=\"ti ti-brand-apple-pay text-4xl\" data-kid=\"1-2-2-1-5-0-2\"></i>\n            <i class=\"ti ti-brand-paypal text-3xl\" data-kid=\"1-2-2-1-5-0-3\"></i>\n          </div>\n          <p class=\"font-body text-[9px] uppercase tracking-[0.5em] font-black text-[#1a0f14]/25 flex items-center gap-3\" data-kid=\"1-2-2-1-5-1\">\n            <i class=\"ti ti-lock-access text-xs\" data-kid=\"1-2-2-1-5-1-0\"></i>\n            SECURE ENCRYPTED CHECKOUT\n          </p>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n</div>",
