      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-cream: #FFF5F7;\n    --color-peach: #FFC9DE;\n    --color-ink: #1A0F14;\n    --color-rose: #C25E7C;\n  }\n\n  body {\n    font-family: 'Inter', sans-serif;\n    color: var(--color-ink);\n    background-color: var(--color-cream);\n  }\n\n  .font-display {\n    font-family: 'Space Grotesk', sans-serif;\n  }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.45);\n    backdrop-filter: blur(24px);\n    border: 1px solid rgba(255, 255, 255, 0.8);\n    box-shadow: 0 30px 60px -12px rgba(194, 94, 124, 0.12);\n  }\n\n  .floating-label-group {\n    position: relative;\n  }\n  \n  .floating-label-input {\n    width: 100%;\n    padding: 1.35rem 1.6rem;\n    background: rgba(255, 255, 255, 0.25);\n    border: 1px solid rgba(255, 255, 255, 0.9);\n    border-radius: 1.5rem;\n    font-size: 1rem;\n    color: var(--color-ink);\n    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n    outline: none;\n  }\n\n  .floating-label-input:focus {\n    border-color: var(--color-rose);\n    background: rgba(255, 255, 255, 0.75);\n    box-shadow: 0 0 25px rgba(194, 94, 124, 0.2);\n  }\n\n  .floating-label-text {\n    position: absolute;\n    left: 1.6rem;\n    top: 1.35rem;\n    color: rgba(26, 15, 20, 0.45);\n    font-size: 1rem;\n    pointer-events: none;\n    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .floating-label-input:focus + .floating-label-text,\n  .floating-label-input:not(:placeholder-shown) + .floating-label-text {\n    transform: translateY(-2.4rem) scale(0.8);\n    left: 0.75rem;\n    color: var(--color-rose);\n    font-weight: 700;\n    letter-spacing: 0.05em;\n  }\n\n  /* Validation States */\n  .input-success {\n    border-color: rgba(16, 185, 129, 0.3) !important;\n    background: rgba(16, 185, 129, 0.03) !important;\n    box-shadow: 0 0 20px rgba(16, 185, 129, 0.05) !important;\n  }\n  .input-error {\n    border-color: rgba(239, 68, 68, 0.3) !important;\n    background: rgba(239, 68, 68, 0.03) !important;\n    box-shadow: 0 0 20px rgba(239, 68, 68, 0.05) !important;\n  }\n\n  .premium-gradient-btn {\n    background: linear-gradient(135deg, #FFC9DE 0%, #C25E7C 100%);\n    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n    box-shadow: 0 20px 50px -10px rgba(194, 94, 124, 0.45);\n  }\n\n  .premium-gradient-btn:hover {\n    transform: translateY(-5px) scale(1.03);\n    box-shadow: 0 25px 60px -5px rgba(194, 94, 124, 0.6), 0 0 30px rgba(255, 201, 222, 0.4);\n    filter: brightness(1.08);\n  }\n\n  .premium-gradient-btn:active {\n    transform: translateY(1px);\n  }\n\n  .order-item-card {\n    transition: transform 0.3s ease;\n  }\n  .order-item-card:hover {\n    transform: translateX(8px);\n  }\n\n  /* Success State Animation */\n  .success-check-pulse {\n    animation: pulse 2s infinite;\n  }\n  @keyframes pulse {\n    0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(194, 94, 124, 0.4); }\n    70% { transform: scale(1.05); box-shadow: 0 0 0 20px rgba(194, 94, 124, 0); }\n    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(194, 94, 124, 0); }\n  }\n\n  /* Hidden state helper */\n  .fade-out { opacity: 0; pointer-events: none; transition: opacity 0.5s ease; }\n  .fade-in { opacity: 1; transition: opacity 0.5s ease; }\n\n</style>\n\n<div class=\"relative min-h-[1200px] overflow-hidden selection:bg-[#C25E7C]/20\" data-kid=\"1\">\n  \n  <div class=\"absolute top-[-20%] left-[-10%] w-[70%] h-[60%] bg-[#FFC9DE]/30 blur-[150px] rounded-full pointer-events-none\" data-kid=\"1-0\"></div>\n  <div class=\"absolute bottom-[-10%] right-[-10%] w-[60%] h-[50%] bg-[#C25E7C]/10 blur-[150px] rounded-full pointer-events-none\" data-kid=\"1-1\"></div>\n  <img src=\"https://images.unsplash.com/photo-1770457732717-c0f2deea07e7?auto=format&w=1920&q=40&fit=crop\" class=\"absolute inset-0 w-full h-full object-cover opacity-10 mix-blend-overlay pointer-events-none\" decoding=\"async\" loading=\"lazy\" data-kid=\"1-2\">\n\n  \n  <nav class=\"fixed top-8 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-48px)] max-w-7xl\" data-kid=\"1-3\">\n    <div class=\"glass-card rounded-full px-8 py-4 flex items-center justify-between border-white/50\" data-kid=\"1-3-0\">\n      <div class=\"flex items-center gap-2\" data-kid=\"1-3-0-0\">\n        <span class=\"font-display text-2xl font-bold tracking-tight\" data-kid=\"1-3-0-0-0\">INK<span class=\"text-[#C25E7C]\" data-kid=\"1-3-0-0-0-0\">SPIRED</span></span>\n      </div>\n      <div class=\"flex items-center gap-6\" data-kid=\"1-3-0-1\">\n        <a href=\"#\" class=\"text-sm font-semibold opacity-60 hover:opacity-100 hover:text-[#C25E7C] transition-all\" data-kid=\"1-3-0-1-0\">Home</a>\n        <a href=\"#\" class=\"text-sm font-bold text-[#C25E7C] bg-[#C25E7C]/10 px-4 py-2 rounded-full border border-[#C25E7C]/10\" data-kid=\"1-3-0-1-1\">Boutique</a>\n        <div class=\"h-4 w-px bg-black/10\" data-kid=\"1-3-0-1-2\"></div>\n        <button class=\"relative\" data-kid=\"1-3-0-1-3\">\n          <i class=\"ti ti-shopping-bag text-xl\" data-kid=\"1-3-0-1-3-0\"></i>\n          <span class=\"absolute -top-2 -right-2 bg-[#C25E7C] text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center\" data-kid=\"1-3-0-1-3-1\">1</span>\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  \n  \n    \n    <div id=\"checkoutView\" class=\"transition-all duration-700 opacity-100 transform translate-y-0\" data-kid=\"1-4\">\n      <header class=\"mb-20 text-center lg:text-left relative\" data-kid=\"1-4-0\">\n        <h1 class=\"font-display text-6xl lg:text-8xl font-bold mb-6 leading-[1.1] tracking-tighter\" data-kid=\"1-4-0-0\">\n          Checkout <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-[#C25E7C] to-[#FFC9DE] drop-shadow-sm\" style=\"-webkit-text-stroke: 1px rgba(194, 94, 124, 0.2);\" data-kid=\"1-4-0-0-0\">Luxury</span>\n        </h1>\n        <p class=\"text-xl text-black/50 max-w-2xl mx-auto lg:mx-0 font-light leading-relaxed\" data-kid=\"1-4-0-1\">Your curation is complete. Now, let us refine the arrival of your premium writing instrument.</p>\n        <div class=\"absolute -top-10 -left-10 opacity-20 pointer-events-none\" data-kid=\"1-4-0-2\">\n          <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/sparkles.svg\" class=\"w-20 h-20\" style=\"filter: invert(47%) sepia(21%) saturate(1131%) hue-rotate(301deg) brightness(88%) contrast(83%);\" data-kid=\"1-4-0-2-0\">\n        </div>\n      </header>\n\n      </div>\n        \n        <aside class=\"lg:col-span-5 lg:sticky lg:top-40\" data-kid=\"1-5\">\n          <div class=\"glass-card rounded-[2.5rem] p-10 border-white/60\" data-kid=\"1-5-0\">\n            <div class=\"flex items-center justify-between mb-10\" data-kid=\"1-5-0-0\">\n              <h2 class=\"font-display text-2xl font-bold flex items-center gap-3\" data-kid=\"1-5-0-0-0\">\n                <i class=\"ti ti-receipt text-[#C25E7C]\" data-kid=\"1-5-0-0-0-0\"></i> Order Summary\n              </h2>\n              <span class=\"bg-[#C25E7C]/10 text-[#C25E7C] px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider\" data-kid=\"1-5-0-0-1\">Review Items</span>\n            </div>\n\n            \n            <div class=\"space-y-6 mb-10\" data-kid=\"1-5-0-1\">\n              <div class=\"order-item-card flex gap-6 items-center group\" data-kid=\"1-5-0-1-0\">\n                <div class=\"relative w-24 h-24 shrink-0\" data-kid=\"1-5-0-1-0-0\">\n                  <div class=\"absolute inset-0 bg-[#FFC9DE] blur-2xl opacity-40 group-hover:opacity-70 transition-opacity\" data-kid=\"1-5-0-1-0-0-0\"></div>\n                  <div class=\"relative w-full h-full bg-white rounded-2xl overflow-hidden border border-white/50 shadow-lg\" data-kid=\"1-5-0-1-0-0-1\">\n                    <img src=\"https://images.unsplash.com/photo-1513666639414-f795d25747a8?auto=format&w=240&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\" decoding=\"async\" loading=\"lazy\" data-kid=\"1-5-0-1-0-0-1-0\">\n                  </div>\n                </div>\n                <div class=\"flex-1 min-w-0\" data-kid=\"1-5-0-1-0-1\">\n                  <h4 class=\"font-display font-bold text-lg text-black truncate\" data-kid=\"1-5-0-1-0-1-0\">The Ethereal Rose Fountain Pen</h4>\n                  <p class=\"text-sm text-black/40 mb-1\" data-kid=\"1-5-0-1-0-1-1\">Hand-polished gold nib • Rose lacquer</p>\n                  <div class=\"flex items-center justify-between\" data-kid=\"1-5-0-1-0-1-2\">\n                    <span class=\"text-sm font-semibold text-[#C25E7C]\" data-kid=\"1-5-0-1-0-1-2-0\">Qty: 1</span>\n                    <span class=\"font-display font-bold text-[#C25E7C]\" data-kid=\"1-5-0-1-0-1-2-1\">₱ 4,500.00</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            \n            <div class=\"space-y-4 pt-8 border-t border-black/5\" data-kid=\"1-5-0-2\">\n              <div class=\"flex justify-between text-black/60 font-medium\" data-kid=\"1-5-0-2-0\">\n                <span data-kid=\"1-5-0-2-0-0\">Subtotal</span>\n                <span data-kid=\"1-5-0-2-0-1\">₱ 4,500.00</span>\n              </div>\n              <div class=\"flex justify-between items-center text-black/60 font-medium\" data-kid=\"1-5-0-2-1\">\n                <span data-kid=\"1-5-0-2-1-0\">Priority White-Glove Shipping</span>\n                <span class=\"text-green-600 italic bg-green-50 px-3 py-1 rounded-full text-xs font-bold\" data-kid=\"1-5-0-2-1-1\">Complimentary</span>\n              </div>\n              <div class=\"pt-6 flex justify-between items-end\" data-kid=\"1-5-0-2-2\">\n                <div data-kid=\"1-5-0-2-2-0\">\n                  <p class=\"text-xs font-bold uppercase tracking-widest text-black/30 mb-1\" data-kid=\"1-5-0-2-2-0-0\">Total to Pay</p>\n                  <h3 class=\"font-display text-4xl font-bold text-[#C25E7C]\" data-kid=\"1-5-0-2-2-0-1\">₱ 4,500.00</h3>\n                </div>\n                <div class=\"flex flex-col items-end\" data-kid=\"1-5-0-2-2-1\">\n                  <span class=\"text-xs font-semibold text-black/40\" data-kid=\"1-5-0-2-2-1-0\">Cash on Delivery</span>\n                  <div class=\"flex gap-1 mt-1 text-[#C25E7C]\" data-kid=\"1-5-0-2-2-1-1\">\n                    <i class=\"ti ti-star-filled text-[10px]\" data-kid=\"1-5-0-2-2-1-1-0\"></i>\n                    <i class=\"ti ti-star-filled text-[10px]\" data-kid=\"1-5-0-2-2-1-1-1\"></i>\n                    <i class=\"ti ti-star-filled text-[10px]\" data-kid=\"1-5-0-2-2-1-1-2\"></i>\n                    <i class=\"ti ti-star-filled text-[10px]\" data-kid=\"1-5-0-2-2-1-1-3\"></i>\n                    <i class=\"ti ti-star-filled text-[10px]\" data-kid=\"1-5-0-2-2-1-1-4\"></i>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \n          <div class=\"mt-8 grid grid-cols-3 gap-4\" data-kid=\"1-5-1\">\n            <div class=\"glass-card rounded-2xl p-4 text-center border-white/40\" data-kid=\"1-5-1-0\">\n              <i class=\"ti ti-shield-check text-[#C25E7C] text-xl mb-1 block\" data-kid=\"1-5-1-0-0\"></i>\n              <span class=\"text-[10px] font-bold uppercase tracking-tight opacity-40\" data-kid=\"1-5-1-0-1\">Authentic</span>\n            </div>\n            <div class=\"glass-card rounded-2xl p-4 text-center border-white/40\" data-kid=\"1-5-1-1\">\n              <i class=\"ti ti-truck-delivery text-[#C25E7C] text-xl mb-1 block\" data-kid=\"1-5-1-1-0\"></i>\n              <span class=\"text-[10px] font-bold uppercase tracking-tight opacity-40\" data-kid=\"1-5-1-1-1\">Fast Ship</span>\n            </div>\n            <div class=\"glass-card rounded-2xl p-4 text-center border-white/40\" data-kid=\"1-5-1-2\">\n              <i class=\"ti ti-award text-[#C25E7C] text-xl mb-1 block\" data-kid=\"1-5-1-2-0\"></i>\n              <span class=\"text-[10px] font-bold uppercase tracking-tight opacity-40\" data-kid=\"1-5-1-2-1\">Warranty</span>\n            </div>\n          </div>\n        </aside>\n\n        \n        \n          <div class=\"glass-card rounded-[3rem] p-12 border-white/80 shadow-2xl relative overflow-hidden\" data-kid=\"1-6\">\n            \n            <div class=\"absolute -right-20 -bottom-20 opacity-5 rotate-12 pointer-events-none\" data-kid=\"1-6-0\">\n              <span class=\"font-display text-[200px] font-bold\" data-kid=\"1-6-0-0\">INK</span>\n            </div>\n\n            <form onsubmit=\"handleFinalSubmit(event)\" id=\"checkoutForm\" class=\"space-y-12 relative z-10\" data-kid=\"1-6-1\">\n              \n              \n              <div class=\"space-y-8\" data-kid=\"1-6-1-0\">\n                <div class=\"flex items-center gap-5 border-b border-black/5 pb-6\" data-kid=\"1-6-1-0-0\">\n                  <div class=\"w-14 h-14 rounded-2xl bg-gradient-to-br from-[#FFC9DE] to-[#C25E7C] flex items-center justify-center text-white shadow-xl\" data-kid=\"1-6-1-0-0-0\">\n                    <i class=\"ti ti-signature text-3xl\" data-kid=\"1-6-1-0-0-0-0\"></i>\n                  </div>\n                  <div data-kid=\"1-6-1-0-0-1\">\n                    <h3 class=\"font-display text-3xl font-bold tracking-tight\" data-kid=\"1-6-1-0-0-1-0\">Identity</h3>\n                    <p class=\"text-sm text-black/40 font-medium\" data-kid=\"1-6-1-0-0-1-1\">Personal particulars for your curated package</p>\n                  </div>\n                </div>\n\n                <div class=\"space-y-8\" data-kid=\"1-6-1-0-1\">\n                  <div class=\"floating-label-group\" data-kid=\"1-6-1-0-1-0\">\n                    <input type=\"text\" id=\"fullName\" class=\"floating-label-input\" placeholder=\" \" value=\"Isabella Sterling\" required data-kid=\"1-6-1-0-1-0-0\">\n                    <label for=\"fullName\" class=\"floating-label-text\" data-kid=\"1-6-1-0-1-0-1\">Full Distinguished Name</label>\n                  </div>\n\n                  <div class=\"grid md:grid-cols-2 gap-8\" data-kid=\"1-6-1-0-1-1\">\n                    <div class=\"floating-label-group\" data-kid=\"1-6-1-0-1-1-0\">\n                      <input type=\"email\" id=\"email\" class=\"floating-label-input\" placeholder=\" \" required data-kid=\"1-6-1-0-1-1-0-0\">\n                      <label for=\"email\" class=\"floating-label-text\" data-kid=\"1-6-1-0-1-1-0-1\">Email Address</label>\n                    </div>\n                    <div class=\"floating-label-group\" data-kid=\"1-6-1-0-1-1-1\">\n                      <input type=\"tel\" id=\"mobile\" class=\"floating-label-input\" placeholder=\" \" required data-kid=\"1-6-1-0-1-1-1-0\">\n                      <label for=\"mobile\" class=\"floating-label-text\" data-kid=\"1-6-1-0-1-1-1-1\">Mobile Access</label>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              \n              <div class=\"space-y-8\" data-kid=\"1-6-1-1\">\n                <div class=\"flex items-center gap-5 border-b border-black/5 pb-6\" data-kid=\"1-6-1-1-0\">\n                  <div class=\"w-14 h-14 rounded-2xl bg-gradient-to-br from-[#FFC9DE] to-[#C25E7C] flex items-center justify-center text-white shadow-xl\" data-kid=\"1-6-1-1-0-0\">\n                    <i class=\"ti ti-map-pin-check text-3xl\" data-kid=\"1-6-1-1-0-0-0\"></i>\n                  </div>\n                  <div data-kid=\"1-6-1-1-0-1\">\n                    <h3 class=\"font-display text-3xl font-bold tracking-tight\" data-kid=\"1-6-1-1-0-1-0\">Destination</h3>\n                    <p class=\"text-sm text-black/40 font-medium\" data-kid=\"1-6-1-1-0-1-1\">The domain where your instrument will arrive</p>\n                  </div>\n                </div>\n\n                <div class=\"space-y-8\" data-kid=\"1-6-1-1-1\">\n                  <div class=\"grid md:grid-cols-2 gap-8\" data-kid=\"1-6-1-1-1-0\">\n                    <div class=\"floating-label-group\" data-kid=\"1-6-1-1-1-0-0\">\n                      <input type=\"text\" id=\"province\" class=\"floating-label-input\" placeholder=\" \" required data-kid=\"1-6-1-1-1-0-0-0\">\n                      <label for=\"province\" class=\"floating-label-text\" data-kid=\"1-6-1-1-1-0-0-1\">City / Province</label>\n                    </div>\n                    <div class=\"floating-label-group\" data-kid=\"1-6-1-1-1-0-1\">\n                      <input type=\"text\" id=\"town\" class=\"floating-label-input\" placeholder=\" \" required data-kid=\"1-6-1-1-1-0-1-0\">\n                      <label for=\"town\" class=\"floating-label-text\" data-kid=\"1-6-1-1-1-0-1-1\">Municipality</label>\n                    </div>\n                  </div>\n\n                  <div class=\"floating-label-group\" data-kid=\"1-6-1-1-1-1\">\n                    <input type=\"text\" id=\"street\" class=\"floating-label-input\" placeholder=\" \" required data-kid=\"1-6-1-1-1-1-0\">\n                    <label for=\"street\" class=\"floating-label-text\" data-kid=\"1-6-1-1-1-1-1\">Estate / Street Address</label>\n                  </div>\n\n                  <div class=\"floating-label-group\" data-kid=\"1-6-1-1-1-2\">\n                    <textarea id=\"notes\" class=\"floating-label-input h-32 resize-none\" placeholder=\" \" data-kid=\"1-6-1-1-1-2-0\"></textarea>\n                    <label for=\"notes\" class=\"floating-label-text\" data-kid=\"1-6-1-1-1-2-1\">Concierge Delivery Notes</label>\n                  </div>\n                </div>\n              </div>\n\n              \n              <div class=\"space-y-6\" data-kid=\"1-6-1-2\">\n                <div class=\"flex items-center justify-between border-b border-black/5 pb-6\" data-kid=\"1-6-1-2-0\">\n                  <div class=\"flex items-center gap-5\" data-kid=\"1-6-1-2-0-0\">\n                    <div class=\"w-14 h-14 rounded-2xl bg-gradient-to-br from-[#FFC9DE] to-[#C25E7C] flex items-center justify-center text-white shadow-xl\" data-kid=\"1-6-1-2-0-0-0\">\n                      <i class=\"ti ti-credit-card text-3xl\" data-kid=\"1-6-1-2-0-0-0-0\"></i>\n                    </div>\n                    <div data-kid=\"1-6-1-2-0-0-1\">\n                      <h3 class=\"font-display text-3xl font-bold tracking-tight\" data-kid=\"1-6-1-2-0-0-1-0\">Sovereign Payment</h3>\n                      <p class=\"text-sm text-black/40 font-medium\" data-kid=\"1-6-1-2-0-0-1-1\">Securely finalize your acquisition</p>\n                    </div>\n                  </div>\n                </div>\n                \n                <div class=\"bg-white/40 border-2 border-[#C25E7C]/20 p-8 rounded-[2rem] flex items-center gap-8 group hover:bg-white/70 transition-all cursor-pointer relative overflow-hidden\" data-kid=\"1-6-1-2-1\">\n                  <div class=\"absolute -right-4 -top-4 opacity-10 pointer-events-none group-hover:scale-110 transition-transform\" data-kid=\"1-6-1-2-1-0\">\n                    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/sparkling-sabre.svg\" class=\"w-24 h-24\" style=\"filter: invert(47%) sepia(21%) saturate(1131%) hue-rotate(301deg) brightness(88%) contrast(83%);\" data-kid=\"1-6-1-2-1-0-0\">\n                  </div>\n                  <div class=\"w-20 h-20 rounded-2xl bg-[#C25E7C]/10 flex items-center justify-center text-[#C25E7C] shrink-0\" data-kid=\"1-6-1-2-1-1\">\n                    <i class=\"ti ti-truck-return text-4xl\" data-kid=\"1-6-1-2-1-1-0\"></i>\n                  </div>\n                  <div class=\"flex-1\" data-kid=\"1-6-1-2-1-2\">\n                    <h4 class=\"font-display font-bold text-xl mb-1\" data-kid=\"1-6-1-2-1-2-0\">Cash on Delivery</h4>\n                    <p class=\"text-sm text-black/50 leading-relaxed\" data-kid=\"1-6-1-2-1-2-1\">Pay with confidence only upon the physical arrival of your order.</p>\n                  </div>\n                  <div class=\"w-9 h-9 rounded-full border-2 border-[#C25E7C] flex items-center justify-center shrink-0 shadow-[0_0_15px_rgba(194,94,124,0.3)]\" data-kid=\"1-6-1-2-1-3\">\n                    <div class=\"w-5 h-5 bg-gradient-to-br from-[#FFC9DE] to-[#C25E7C] rounded-full\" data-kid=\"1-6-1-2-1-3-0\"></div>\n                  </div>\n                </div>\n              </div>\n\n              \n              <div class=\"pt-12 flex flex-col items-center\" data-kid=\"1-6-1-3\">\n                <button type=\"submit\" class=\"premium-gradient-btn w-full md:w-auto md:min-w-[480px] py-8 px-20 rounded-full text-white font-display font-bold text-2xl uppercase tracking-[0.3em] flex items-center justify-center gap-6 group\" data-kid=\"1-6-1-3-0\">\n                  Complete Order\n                  <i class=\"ti ti-crown text-3xl group-hover:rotate-12 transition-transform\" data-kid=\"1-6-1-3-0-0\"></i>\n                </button>\n              <p class=\"mt-6 text-sm text-black/30 font-medium flex items-center gap-2\" data-kid=\"1-6-1-3-1\">\n                <i class=\"ti ti-lock\" data-kid=\"1-6-1-3-1-0\"></i> SSL Secured Transaction • Inkspired Premium Guarantee\n              </p>\n            </div>\n          </form>\n        \n      </div>\n    \n\n    \n    <div id=\"successView\" class=\"hidden flex flex-col items-center justify-center min-h-[600px] text-center max-w-3xl mx-auto\" data-kid=\"1-7\">\n      <div class=\"relative mb-12\" data-kid=\"1-7-0\">\n        <div class=\"absolute inset-0 bg-[#C25E7C]/20 blur-[100px] rounded-full\" data-kid=\"1-7-0-0\"></div>\n        <div class=\"w-32 h-32 bg-gradient-to-br from-[#FFC9DE] to-[#C25E7C] rounded-[2.5rem] flex items-center justify-center text-white shadow-2xl relative success-check-pulse\" data-kid=\"1-7-0-1\">\n          <i class=\"ti ti-check text-6xl\" data-kid=\"1-7-0-1-0\"></i>\n        </div>\n      </div>\n      \n      <h2 class=\"font-display text-5xl md:text-6xl font-bold mb-6\" data-kid=\"1-7-1\">Your Journey Begins</h2>\n      <p class=\"text-xl text-black/50 mb-10 leading-relaxed\" data-kid=\"1-7-2\">\n        Order <span class=\"font-bold text-[#C25E7C]\" data-kid=\"1-7-2-0\">#INK-99201</span> is confirmed. <br data-kid=\"1-7-2-1\">\n        Your premium writing instrument is being prepared for its new master.\n      </p>\n\n      <div class=\"glass-card rounded-3xl p-8 w-full mb-12 border-white/60\" data-kid=\"1-7-3\">\n        <div class=\"flex flex-col md:flex-row justify-center gap-8 md:gap-16\" data-kid=\"1-7-3-0\">\n          <div class=\"text-center\" data-kid=\"1-7-3-0-0\">\n            <span class=\"text-xs font-bold uppercase tracking-widest text-black/30 block mb-2\" data-kid=\"1-7-3-0-0-0\">Notification Sent To</span>\n            <p class=\"font-semibold\" id=\"successEmail\" data-kid=\"1-7-3-0-0-1\">isabella@sterling.com</p>\n          </div>\n          <div class=\"text-center\" data-kid=\"1-7-3-0-1\">\n            <span class=\"text-xs font-bold uppercase tracking-widest text-black/30 block mb-2\" data-kid=\"1-7-3-0-1-0\">Estimated Arrival</span>\n            <p class=\"font-semibold text-green-600\" data-kid=\"1-7-3-0-1-1\">2-3 Business Days</p>\n          </div>\n        </div>\n      </div>\n\n      <button onclick=\"location.reload()\" class=\"font-display font-bold text-[#C25E7C] flex items-center gap-2 hover:gap-4 transition-all uppercase tracking-widest group\" data-kid=\"1-7-4\">\n        <i class=\"ti ti-arrow-left\" data-kid=\"1-7-4-0\"></i> Return to Boutique\n        <div class=\"h-px w-0 group-hover:w-12 bg-[#C25E7C] transition-all\" data-kid=\"1-7-4-1\"></div>\n      </button>\n    </div>\n\n  \n\n  \n  <footer class=\"relative z-10 pt-20 pb-12 border-t border-black/5\" data-kid=\"1-8\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"1-8-0\">\n      <div class=\"flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"1-8-0-0\">\n        <div class=\"text-center md:text-left\" data-kid=\"1-8-0-0-0\">\n          <span class=\"font-display text-xl font-bold tracking-tight block mb-2\" data-kid=\"1-8-0-0-0-0\">INK<span class=\"text-[#C25E7C]\" data-kid=\"1-8-0-0-0-0-0\">SPIRED</span></span>\n          <p class=\"text-xs text-black/30 font-medium uppercase tracking-widest\" data-kid=\"1-8-0-0-0-1\">&copy; 2026 Crafted with precision for exceptional writing.</p>\n        </div>\n        <div class=\"flex gap-8\" data-kid=\"1-8-0-0-1\">\n          <a href=\"#\" class=\"text-sm font-semibold hover:text-[#C25E7C] transition-colors\" data-kid=\"1-8-0-0-1-0\">Privacy</a>\n          <a href=\"#\" class=\"text-sm font-semibold hover:text-[#C25E7C] transition-colors\" data-kid=\"1-8-0-0-1-1\">Terms</a>\n          <a href=\"#\" class=\"text-sm font-semibold hover:text-[#C25E7C] transition-colors\" data-kid=\"1-8-0-0-1-2\">Concierge</a>\n        </div>\n      </div>\n    </div>\n  </footer>\n\n\n<script data-kid=\"1-9\">\n  function handleFinalSubmit(event) {\n    event.preventDefault();\n    const btn = event.submitter;\n    const originalContent = btn.innerHTML;\n    \n    // Simulate luxury loading\n    btn.disabled = true;\n    btn.innerHTML = '<i class=\"ti ti-loader-2 animate-spin text-3xl\"></i> Processing...';\n    \n    setTimeout(() => {\n      document.getElementById('checkoutView').classList.add('fade-out');\n      \n      setTimeout(() => {\n        document.getElementById('checkoutView').classList.add('hidden');\n        const successView = document.getElementById('successView');\n        successView.classList.remove('hidden');\n        successView.classList.add('fade-in');\n        window.scrollTo({ top: 0, behavior: 'smooth' });\n        \n        // Update success info\n        const email = document.getElementById('email').value;\n        if(email) document.getElementById('successEmail').textContent = email;\n      }, 500);\n    }, 2000);\n  }\n\n  // Interactive floating labels validation simulation\n  document.querySelectorAll('.floating-label-input').forEach(input => {\n    input.addEventListener('blur', function() {\n      if (this.value.trim().length > 3) {\n        this.classList.add('input-success');\n        this.classList.remove('input-error');\n      } else if (this.value.trim().length > 0) {\n        this.classList.add('input-error');\n        this.classList.remove('input-success');\n      } else {\n        this.classList.remove('input-success', 'input-error');\n      }\n    });\n  });\n</script></div>",
