      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&family=Inter:wght@300;400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --rose-deep: #c25e7c;\n    --soft-peach: #FFC9DE;\n    --pink-cream: #FFF5F7;\n    --ink-black: #1A0F14;\n  }\n\n  body {\n    font-family: 'Inter', sans-serif;\n    background-color: var(--pink-cream);\n    color: var(--ink-black);\n    overflow-x: hidden;\n  }\n\n  .font-editorial {\n    font-family: 'Space Grotesk', sans-serif;\n  }\n\n  /* Animated Background */\n  .bg-canvas {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: -2;\n    background: linear-gradient(135deg, #FFF5F7 0%, #FFC9DE 50%, #FFF5F7 100%);\n    background-size: 400% 400%;\n    animation: gradientBG 15s ease infinite;\n  }\n\n  @keyframes gradientBG {\n    0% { background-position: 0% 50%; }\n    50% { background-position: 100% 50%; }\n    100% { background-position: 0% 50%; }\n  }\n\n  .floating-orb {\n    position: fixed;\n    border-radius: 50%;\n    filter: blur(80px);\n    z-index: -1;\n    opacity: 0.4;\n    pointer-events: none;\n  }\n\n  /* Glassmorphism Styles */\n  .glass-panel {\n    background: rgba(255, 255, 255, 0.15);\n    backdrop-filter: blur(30px) saturate(150%);\n    -webkit-backdrop-filter: blur(30px) saturate(150%);\n    border: 1px solid rgba(255, 255, 255, 0.3);\n    box-shadow: 0 20px 50px rgba(194, 94, 124, 0.05);\n  }\n\n  .grain-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background-image: url(\"https://www.transparenttextures.com/patterns/natural-paper.png\");\n    opacity: 0.15;\n    pointer-events: none;\n    z-index: 100;\n  }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.45);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    border: 1px solid rgba(255, 255, 255, 0.7);\n    box-shadow: 0 4px 24px -1px rgba(194, 94, 124, 0.05);\n    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .glass-card:hover {\n    background: rgba(255, 255, 255, 0.7);\n    transform: translateY(-12px) scale(1.01);\n    box-shadow: 0 40px 80px -20px rgba(194, 94, 124, 0.18);\n    border-color: rgba(194, 94, 124, 0.2);\n  }\n\n  /* Pill Navbar Animation */\n  .nav-link-pill {\n    position: relative;\n    padding: 8px 16px;\n    border-radius: 9999px;\n    transition: all 0.3s ease;\n  }\n  \n  .nav-link-pill.active {\n    background: var(--rose-deep);\n    color: white !important;\n  }\n\n  /* Custom Cursor / Mouse Follow */\n  #mouseGlow {\n    position: fixed;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(194, 94, 124, 0.08) 0%, rgba(255, 201, 222, 0) 70%);\n    border-radius: 50%;\n    pointer-events: none;\n    z-index: -1;\n    transform: translate(-50%, -50%);\n    transition: width 0.3s ease, height 0.3s ease;\n  }\n\n  /* Parallax Elements */\n  .parallax-img {\n    will-change: transform;\n  }\n\n  /* Scrollbar */\n  ::-webkit-scrollbar { width: 8px; }\n  ::-webkit-scrollbar-track { background: var(--pink-cream); }\n  ::-webkit-scrollbar-thumb { background: var(--soft-peach); border-radius: 10px; }\n  ::-webkit-scrollbar-thumb:hover { background: var(--rose-deep); }\n</style>\n\n\n<div class=\"bg-canvas\" data-kid=\"1\"></div>\n<div class=\"grain-overlay\" data-kid=\"2\"></div>\n<div class=\"floating-orb w-96 h-96 bg-[var(--soft-peach)] top-[-10%] left-[-5%]\" data-kid=\"3\"></div>\n<div class=\"floating-orb w-[500px] h-[500px] bg-[#FFDFDF] bottom-[-10%] right-[-10%]\" data-kid=\"4\"></div>\n<div id=\"mouseGlow\" data-kid=\"5\"></div>\n\n\n<nav id=\"pill-nav\" class=\"fixed top-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 p-2 glass-panel rounded-full px-6 shadow-2xl\" data-kid=\"6\">\n  <a href=\"#\" class=\"font-editorial font-bold text-xl tracking-tight mr-4\" data-kid=\"6-0\">\n    INK<span class=\"text-[var(--rose-deep)]\" data-kid=\"6-0-0\">SPIRED</span>\n  </a>\n  <div class=\"hidden md:flex items-center gap-1\" data-kid=\"6-1\">\n    <a href=\"#\" class=\"nav-link-pill active text-sm font-medium\" data-kid=\"6-1-0\">Home</a>\n    <a href=\"#featured\" class=\"nav-link-pill text-sm font-medium text-gray-600 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"6-1-1\">Featured</a>\n    <a href=\"#shop\" class=\"nav-link-pill text-sm font-medium text-gray-600 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"6-1-2\">Shop</a>\n    <a href=\"#craft\" class=\"nav-link-pill text-sm font-medium text-gray-600 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"6-1-3\">Craftsmanship</a>\n  </div>\n  <div class=\"flex items-center gap-3 ml-4 border-l border-white/30 pl-4\" data-kid=\"6-2\">\n    <button class=\"relative p-2 text-gray-700 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"6-2-0\">\n      <i class=\"ti ti-search text-xl\" data-kid=\"6-2-0-0\"></i>\n    </button>\n    <button class=\"relative p-2 text-gray-700 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"6-2-1\">\n      <i class=\"ti ti-shopping-bag text-xl\" data-kid=\"6-2-1-0\"></i>\n      <span class=\"absolute top-0 right-0 w-4 h-4 bg-[var(--rose-deep)] text-white text-[10px] flex items-center justify-center rounded-full\" data-kid=\"6-2-1-1\">0</span>\n    </button>\n    <button class=\"p-2 text-gray-700 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"6-2-2\">\n      <i class=\"ti ti-user text-xl\" data-kid=\"6-2-2-0\"></i>\n    </button>\n  </div>\n</nav>\n\n<main class=\"relative z-10\" data-kid=\"7\">\n  \n  <section class=\"h-[850px] flex items-center justify-center relative px-6 overflow-hidden\" data-kid=\"7-0\">\n    \n    <img src=\"https://images.unsplash.com/photo-1513666639414-f795d25747a8?auto=format&w=600&q=80&fit=crop\" alt=\"Premium Pen\" class=\"parallax-img absolute left-[10%] top-[20%] w-72 rounded-3xl shadow-2xl rotate-[-12deg] z-0 opacity-80\" data-speed=\"-0.05\" data-kid=\"7-0-0\">\n    \n    <img src=\"https://images.unsplash.com/photo-1515709969750-23a5a6b47a5e?auto=format&w=600&q=80&fit=crop\" alt=\"Premium Pen Detail\" class=\"parallax-img absolute right-[8%] bottom-[15%] w-80 rounded-3xl shadow-2xl rotate-[8deg] z-0 opacity-80\" data-speed=\"0.08\" data-kid=\"7-0-1\">\n\n    \n    <div id=\"frosted-panel\" class=\"relative z-10 glass-panel max-w-4xl w-full p-16 md:p-24 rounded-[70px] text-center border-white/50\" data-kid=\"7-0-2\">\n      <div class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/50 text-[var(--rose-deep)] text-[10px] font-bold tracking-[0.3em] mb-8 uppercase border border-white/40 shadow-sm\" data-kid=\"7-0-2-0\">\n        <i class=\"ti ti-sparkles\" data-kid=\"7-0-2-0-0\"></i> EST. 2026 LUXURY COLLECTION\n      </div>\n      <h1 class=\"font-editorial text-7xl md:text-9xl font-bold leading-[0.82] text-[var(--ink-black)] mb-8 tracking-tighter\" data-kid=\"7-0-2-1\">\n        Crafted for<br data-kid=\"7-0-2-1-0\"><span class=\"text-[var(--rose-deep)] italic\" data-kid=\"7-0-2-1-1\">exceptional</span> writing\n      </h1>\n      <p class=\"text-gray-600 text-lg md:text-xl max-w-xl mx-auto mb-12 font-light leading-relaxed\" data-kid=\"7-0-2-2\">\n        Elevate your correspondence with the world's finest hand-finished writing instruments, designed for those who appreciate the art of handwriting.\n      </p>\n      <div class=\"flex flex-col md:flex-row items-center justify-center gap-6\" data-kid=\"7-0-2-3\">\n        <a href=\"#shop\" class=\"group relative px-10 py-5 bg-gradient-to-r from-[var(--rose-deep)] to-[#a0455d] text-white rounded-full font-semibold text-lg shadow-xl hover:shadow-[0_20px_40px_-10px_rgba(194,94,124,0.4)] transition-all overflow-hidden\" data-kid=\"7-0-2-3-0\">\n          <span class=\"relative z-10\" data-kid=\"7-0-2-3-0-0\">Explore Store</span>\n          <div class=\"absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300\" data-kid=\"7-0-2-3-0-1\"></div>\n        </a>\n        <a href=\"#\" class=\"flex items-center gap-2 text-[var(--ink-black)] font-semibold text-lg hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"7-0-2-3-1\">\n          View Lookbook <i class=\"ti ti-arrow-right\" data-kid=\"7-0-2-3-1-0\"></i>\n        </a>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"featured\" class=\"py-32 px-6\" data-kid=\"7-1\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"7-1-0\">\n      <div class=\"flex flex-col items-center text-center mb-20\" data-kid=\"7-1-0-0\">\n        <h2 class=\"font-editorial text-5xl font-bold mb-4\" data-kid=\"7-1-0-0-0\">Curated Favorites</h2>\n        <p class=\"text-gray-500 max-w-md\" data-kid=\"7-1-0-0-1\">Signature pieces that define the Inkspired legacy of precision and elegance.</p>\n      </div>\n\n      <div class=\"relative flex justify-center items-center py-20 min-h-[600px]\" style=\"perspective: 2000px;\" data-kid=\"7-1-0-1\">\n        \n        <div class=\"glass-card w-72 h-[440px] rounded-[48px] p-6 shadow-xl origin-right -rotate-y-[35deg] -translate-x-16 opacity-40 hover:opacity-100 hover:rotate-y-0 hover:translate-x-0 transition-all duration-700 z-0\" data-kid=\"7-1-0-1-0\">\n          <img src=\"https://images.unsplash.com/photo-1541693560393-26ac180b567b?auto=format&w=600&q=80&fit=crop\" alt=\"Pen\" class=\"w-full h-56 object-cover rounded-[32px] mb-6\" data-kid=\"7-1-0-1-0-0\">\n          <h3 class=\"font-editorial text-xl font-bold mb-2\" data-kid=\"7-1-0-1-0-1\">Rose Marble</h3>\n          <p class=\"text-sm text-gray-500\" data-kid=\"7-1-0-1-0-2\">Signature Ballpoint</p>\n        </div>\n        \n        <div class=\"glass-card w-80 h-[520px] rounded-[56px] p-8 shadow-[0_50px_100px_-20px_rgba(194, 94, 124, 0.25)] z-20 relative -mt-4\" data-kid=\"7-1-0-1-1\">\n           <div class=\"absolute top-8 left-8 px-4 py-1.5 bg-white/90 backdrop-blur-md rounded-full text-[10px] font-bold text-[var(--rose-deep)] tracking-widest border border-white/50 shadow-sm flex items-center gap-2\" data-kid=\"7-1-0-1-1-0\">\n             <div class=\"w-1.5 h-1.5 bg-[var(--rose-deep)] rounded-full animate-pulse\" data-kid=\"7-1-0-1-1-0-0\"></div>\n             BEST SELLER\n           </div>\n          <img src=\"https://images.unsplash.com/photo-1513542992587-cd39ba97057c?auto=format&w=600&q=80&fit=crop\" alt=\"The Sovereign Pen\" class=\"w-full h-64 object-cover rounded-[40px] mb-8 shadow-inner\" data-kid=\"7-1-0-1-1-1\">\n          <h3 class=\"font-editorial text-2xl font-bold mb-2\" data-kid=\"7-1-0-1-1-2\">The Sovereign</h3>\n          <p class=\"text-gray-500 mb-6 font-light\" data-kid=\"7-1-0-1-1-3\">18k Gold Nib Fountain Pen</p>\n          <div class=\"flex justify-between items-center mt-auto\" data-kid=\"7-1-0-1-1-4\">\n            <span class=\"text-2xl font-bold text-[var(--rose-deep)]\" data-kid=\"7-1-0-1-1-4-0\">₱ 2,450</span>\n            <button class=\"w-14 h-14 bg-gradient-to-br from-[var(--rose-deep)] to-[#a0455d] text-white rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-transform\" data-kid=\"7-1-0-1-1-4-1\">\n              <i class=\"ti ti-plus text-xl\" data-kid=\"7-1-0-1-1-4-1-0\"></i>\n            </button>\n          </div>\n        </div>\n        \n        <div class=\"glass-card w-72 h-[440px] rounded-[48px] p-6 shadow-xl origin-left rotate-y-[35deg] translate-x-16 opacity-40 hover:opacity-100 hover:rotate-y-0 hover:translate-x-0 transition-all duration-700 z-0\" data-kid=\"7-1-0-1-2\">\n          <img src=\"https://images.unsplash.com/photo-1547516508-9534317dc5c5?auto=format&w=600&q=80&fit=crop\" alt=\"Pen\" class=\"w-full h-56 object-cover rounded-[32px] mb-6\" data-kid=\"7-1-0-1-2-0\">\n          <h3 class=\"font-editorial text-xl font-bold mb-2\" data-kid=\"7-1-0-1-2-1\">Midnight Matte</h3>\n          <p class=\"text-sm text-gray-500\" data-kid=\"7-1-0-1-2-2\">Executive Rollerball</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"shop\" class=\"py-32 bg-white/30\" data-kid=\"7-2\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"7-2-0\">\n      <div class=\"flex flex-col md:flex-row md:items-end justify-between gap-12 mb-20\" data-kid=\"7-2-0-0\">\n        <div data-kid=\"7-2-0-0-0\">\n          <h2 class=\"font-editorial text-5xl font-bold mb-4\" data-kid=\"7-2-0-0-0-0\">Our Boutique</h2>\n          <div class=\"flex flex-wrap gap-3\" data-kid=\"7-2-0-0-0-1\">\n            <button data-cat=\"All\" class=\"tab active px-6 py-2.5 rounded-full bg-[var(--rose-deep)] text-white font-medium text-sm transition-all shadow-lg shadow-[var(--rose-deep)]/20\" data-kid=\"7-2-0-0-0-1-0\">All Instruments</button>\n            <button data-cat=\"Ballpen\" class=\"tab px-6 py-2.5 rounded-full bg-white text-gray-600 font-medium text-sm hover:bg-white/80 transition-all border border-white/50\" data-kid=\"7-2-0-0-0-1-1\">Ballpoint</button>\n            <button data-cat=\"Fountain\" class=\"tab px-6 py-2.5 rounded-full bg-white text-gray-600 font-medium text-sm hover:bg-white/80 transition-all border border-white/50\" data-kid=\"7-2-0-0-0-1-2\">Fountain</button>\n            <button data-cat=\"Gel\" class=\"tab px-6 py-2.5 rounded-full bg-white text-gray-600 font-medium text-sm hover:bg-white/80 transition-all border border-white/50\" data-kid=\"7-2-0-0-0-1-3\">Gel Ink</button>\n            <button data-cat=\"Marker\" class=\"tab px-6 py-2.5 rounded-full bg-white text-gray-600 font-medium text-sm hover:bg-white/80 transition-all border border-white/50\" data-kid=\"7-2-0-0-0-1-4\">Markers</button>\n          </div>\n        </div>\n        <div class=\"relative w-full md:w-80\" data-kid=\"7-2-0-0-1\">\n          <input type=\"text\" id=\"searchInput\" placeholder=\"Search instruments...\" class=\"w-full pl-12 pr-6 py-4 bg-white/50 border border-white/40 rounded-full focus:outline-none focus:ring-2 focus:ring-[var(--rose-deep)]/20 transition-all backdrop-blur-sm\" data-kid=\"7-2-0-0-1-0\">\n          <i class=\"ti ti-search absolute left-5 top-1/2 -translate-y-1/2 text-gray-400\" data-kid=\"7-2-0-0-1-1\"></i>\n        </div>\n      </div>\n\n      \n      <div id=\"appGrid\" class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10\" data-kid=\"7-2-0-1\">\n        \n        <div class=\"glass-card product-item group rounded-[40px] p-6\" data-cat=\"Fountain\" data-kid=\"7-2-0-1-0\">\n          <div class=\"relative h-[400px] rounded-[32px] overflow-hidden mb-8\" data-kid=\"7-2-0-1-0-0\">\n            <img src=\"https://images.unsplash.com/photo-1585336261022-680e295ce3fe?auto=format&w=800&q=80&fit=crop\" alt=\"Pen\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" data-kid=\"7-2-0-1-0-0-0\">\n            <div class=\"absolute inset-0 bg-black/5 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"7-2-0-1-0-0-1\"></div>\n            <button class=\"absolute bottom-6 right-6 translate-y-10 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 w-14 h-14 bg-white text-[var(--rose-deep)] rounded-full shadow-2xl flex items-center justify-center hover:bg-[var(--rose-deep)] hover:text-white\" data-kid=\"7-2-0-1-0-0-2\">\n              <i class=\"ti ti-plus text-2xl\" data-kid=\"7-2-0-1-0-0-2-0\"></i>\n            </button>\n          </div>\n          <div class=\"px-2\" data-kid=\"7-2-0-1-0-1\">\n            <span class=\"text-[var(--rose-deep)] text-xs font-bold tracking-widest uppercase mb-2 block\" data-kid=\"7-2-0-1-0-1-0\">Premium Fountain</span>\n            <h3 class=\"font-editorial text-2xl font-bold mb-2\" data-kid=\"7-2-0-1-0-1-1\">Gold Nib Elite</h3>\n            <div class=\"flex items-center justify-between\" data-kid=\"7-2-0-1-0-1-2\">\n              <p class=\"text-xl font-bold text-[var(--ink-black)]\" data-kid=\"7-2-0-1-0-1-2-0\">₱ 1,299.00</p>\n              <div class=\"flex items-center gap-1 text-amber-400\" data-kid=\"7-2-0-1-0-1-2-1\">\n                <i class=\"ti ti-star-filled\" data-kid=\"7-2-0-1-0-1-2-1-0\"></i>\n                <span class=\"text-gray-400 text-sm font-medium\" data-kid=\"7-2-0-1-0-1-2-1-1\">4.9 (1.2k)</span>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"glass-card product-item group rounded-[40px] p-6\" data-cat=\"Ballpen\" data-kid=\"7-2-0-1-1\">\n          <div class=\"relative h-[400px] rounded-[32px] overflow-hidden mb-8\" data-kid=\"7-2-0-1-1-0\">\n            <img src=\"https://images.unsplash.com/photo-1513542992587-cd39ba97057c?auto=format&w=800&q=80&fit=crop\" alt=\"Premium Ballpoint Pen\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" data-kid=\"7-2-0-1-1-0-0\">\n            <div class=\"absolute inset-0 bg-black/5 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"7-2-0-1-1-0-1\"></div>\n             <button class=\"absolute bottom-6 right-6 translate-y-10 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 w-14 h-14 bg-white text-[var(--rose-deep)] rounded-full shadow-2xl flex items-center justify-center hover:bg-[var(--rose-deep)] hover:text-white\" data-kid=\"7-2-0-1-1-0-2\">\n              <i class=\"ti ti-plus text-2xl\" data-kid=\"7-2-0-1-1-0-2-0\"></i>\n            </button>\n          </div>\n          <div class=\"px-2\" data-kid=\"7-2-0-1-1-1\">\n            <span class=\"text-[var(--rose-deep)] text-xs font-bold tracking-widest uppercase mb-2 block\" data-kid=\"7-2-0-1-1-1-0\">Office Classic</span>\n            <h3 class=\"font-editorial text-2xl font-bold mb-2\" data-kid=\"7-2-0-1-1-1-1\">Retractable Elite</h3>\n            <div class=\"flex items-center justify-between\" data-kid=\"7-2-0-1-1-1-2\">\n              <p class=\"text-xl font-bold text-[var(--ink-black)]\" data-kid=\"7-2-0-1-1-1-2-0\">₱ 289.00</p>\n              <div class=\"flex items-center gap-1 text-amber-400\" data-kid=\"7-2-0-1-1-1-2-1\">\n                <i class=\"ti ti-star-filled\" data-kid=\"7-2-0-1-1-1-2-1-0\"></i>\n                <span class=\"text-gray-400 text-sm font-medium\" data-kid=\"7-2-0-1-1-1-2-1-1\">4.6 (850)</span>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"glass-card product-item group rounded-[40px] p-6\" data-cat=\"Gel\" data-kid=\"7-2-0-1-2\">\n          <div class=\"relative h-[400px] rounded-[32px] overflow-hidden mb-8\" data-kid=\"7-2-0-1-2-0\">\n            <img src=\"https://images.unsplash.com/photo-1531346878377-a5be20888e57?auto=format&w=800&q=80&fit=crop\" alt=\"Pen\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" data-kid=\"7-2-0-1-2-0-0\">\n             <button class=\"absolute bottom-6 right-6 translate-y-10 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 w-14 h-14 bg-white text-[var(--rose-deep)] rounded-full shadow-2xl flex items-center justify-center hover:bg-[var(--rose-deep)] hover:text-white\" data-kid=\"7-2-0-1-2-0-1\">\n              <i class=\"ti ti-plus text-2xl\" data-kid=\"7-2-0-1-2-0-1-0\"></i>\n            </button>\n          </div>\n          <div class=\"px-2\" data-kid=\"7-2-0-1-2-1\">\n            <span class=\"text-[var(--rose-deep)] text-xs font-bold tracking-widest uppercase mb-2 block\" data-kid=\"7-2-0-1-2-1-0\">Smooth Flow</span>\n            <h3 class=\"font-editorial text-2xl font-bold mb-2\" data-kid=\"7-2-0-1-2-1-1\">Silk Gel Ink</h3>\n            <div class=\"flex items-center justify-between\" data-kid=\"7-2-0-1-2-1-2\">\n              <p class=\"text-xl font-bold text-[var(--ink-black)]\" data-kid=\"7-2-0-1-2-1-2-0\">₱ 145.00</p>\n              <div class=\"flex items-center gap-1 text-amber-400\" data-kid=\"7-2-0-1-2-1-2-1\">\n                <i class=\"ti ti-star-filled\" data-kid=\"7-2-0-1-2-1-2-1-0\"></i>\n                <span class=\"text-gray-400 text-sm font-medium\" data-kid=\"7-2-0-1-2-1-2-1-1\">4.8 (2.1k)</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"craft\" class=\"py-32 overflow-hidden\" data-kid=\"7-3\">\n    <div class=\"max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center\" data-kid=\"7-3-0\">\n      <div class=\"reveal-content\" data-kid=\"7-3-0-0\">\n        <span class=\"text-[var(--rose-deep)] font-bold tracking-widest uppercase text-sm mb-4 block\" data-kid=\"7-3-0-0-0\">THE ART OF THE PEN</span>\n        <h2 class=\"font-editorial text-6xl font-bold mb-8 leading-tight\" data-kid=\"7-3-0-0-1\">Masterfully crafted for your <span class=\"text-[var(--rose-deep)] italic\" data-kid=\"7-3-0-0-1-0\">finest thoughts.</span></h2>\n        <p class=\"text-gray-600 text-lg mb-10 leading-relaxed\" data-kid=\"7-3-0-0-2\">\n          Every Inkspired instrument undergoes a rigorous 48-hour finishing process. From the hand-polished nibs to the balanced resin bodies, we ensure each pen is a masterpiece of ergonomics and aesthetics.\n        </p>\n        <div class=\"grid grid-cols-2 gap-8 mb-10\" data-kid=\"7-3-0-0-3\">\n          <div data-kid=\"7-3-0-0-3-0\">\n            <h4 class=\"font-bold text-2xl mb-1\" data-kid=\"7-3-0-0-3-0-0\">100%</h4>\n            <p class=\"text-sm text-gray-500\" data-kid=\"7-3-0-0-3-0-1\">Hand Finished</p>\n          </div>\n          <div data-kid=\"7-3-0-0-3-1\">\n            <h4 class=\"font-bold text-2xl mb-1\" data-kid=\"7-3-0-0-3-1-0\">24k</h4>\n            <p class=\"text-sm text-gray-500\" data-kid=\"7-3-0-0-3-1-1\">Gold Plated Nibs</p>\n          </div>\n        </div>\n        <a href=\"#\" class=\"inline-flex items-center gap-3 text-lg font-bold border-b-2 border-[var(--rose-deep)] pb-1 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"7-3-0-0-4\">\n          Learn about our process <i class=\"ti ti-arrow-up-right\" data-kid=\"7-3-0-0-4-0\"></i>\n        </a>\n      </div>\n      <div class=\"relative h-[600px] rounded-[60px] overflow-hidden shadow-2xl reveal-media\" data-kid=\"7-3-0-1\">\n        <video src=\"https://videos.pexels.com/video-files/3826729/3826729-uhd_4096_2160_25fps.mp4\" poster=\"https://images.pexels.com/videos/3826729/pexels-photo-3826729.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover\" data-kid=\"7-3-0-1-0\"></video>\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/40 to-transparent\" data-kid=\"7-3-0-1-1\"></div>\n        <div class=\"absolute bottom-10 left-10 text-white\" data-kid=\"7-3-0-1-2\">\n          <p class=\"text-xs font-bold tracking-widest uppercase mb-1 opacity-70\" data-kid=\"7-3-0-1-2-0\">Watch Process</p>\n          <h3 class=\"font-editorial text-2xl font-bold\" data-kid=\"7-3-0-1-2-1\">NIB POLISHING</h3>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 relative\" data-kid=\"7-4\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"7-4-0\">\n      <div class=\"glass-panel p-16 md:p-24 rounded-[80px] grid lg:grid-cols-2 gap-16 items-center relative overflow-hidden border-none shadow-[0_60px_120px_-30px_rgba(194,94,124,0.12)]\" data-kid=\"7-4-0-0\">\n        <div class=\"absolute top-[-10%] right-[-10%] w-[500px] h-[500px] bg-[var(--soft-peach)]/20 rounded-full blur-[120px] pointer-events-none\" data-kid=\"7-4-0-0-0\"></div>\n        \n        <div data-kid=\"7-4-0-0-1\">\n          <span class=\"inline-block px-4 py-1 rounded-full bg-white/60 text-[var(--rose-deep)] text-[10px] font-bold tracking-[0.3em] mb-6 uppercase\" data-kid=\"7-4-0-0-1-0\">Maison Circle</span>\n          <h2 class=\"font-editorial text-6xl md:text-7xl font-bold mb-8 leading-[0.95] text-[var(--ink-black)]\" data-kid=\"7-4-0-0-1-1\">Join the <br data-kid=\"7-4-0-0-1-1-0\"><span class=\"text-[var(--rose-deep)] italic\" data-kid=\"7-4-0-0-1-1-1\">Connoisseurs</span></h2>\n          <p class=\"text-gray-500 text-lg mb-10 max-w-sm leading-relaxed font-light\" data-kid=\"7-4-0-0-1-2\">Get exclusive access to limited edition drops, artisanal workshop stories, and member-only events.</p>\n          \n          <form class=\"flex flex-col sm:flex-row items-center gap-3 w-full max-w-md\" data-kid=\"7-4-0-0-1-3\">\n            <input type=\"email\" placeholder=\"Your boutique email\" class=\"w-full px-8 py-5 rounded-full bg-white/80 border border-white/40 focus:outline-none focus:ring-2 focus:ring-[var(--rose-deep)]/30 shadow-sm backdrop-blur-md\" data-kid=\"7-4-0-0-1-3-0\">\n            <button class=\"w-full sm:w-auto px-10 py-5 bg-[var(--ink-black)] text-white rounded-full font-bold hover:bg-[var(--rose-deep)] transition-all shadow-xl whitespace-nowrap\" data-kid=\"7-4-0-0-1-3-1\">Subscribe</button>\n          </form>\n        </div>\n\n        <div class=\"relative hidden lg:block h-full min-h-[400px]\" data-kid=\"7-4-0-0-2\">\n          <div class=\"absolute inset-0 border-[20px] border-white/30 rounded-[70px] -m-4 z-0\" data-kid=\"7-4-0-0-2-0\"></div>\n          <img src=\"https://images.unsplash.com/photo-1543779848-da02f76efe5e?auto=format&w=800&q=80&fit=crop\" alt=\"Premium Paper and Pen\" class=\"absolute inset-0 w-full h-full object-cover rounded-[60px] shadow-2xl scale-110 -rotate-3 hover:rotate-0 hover:scale-105 transition-all duration-1000 z-10\" data-kid=\"7-4-0-0-2-1\">\n        </div>\n      </div>\n    </div>\n  </section>\n</main>\n\n\n<footer class=\"bg-[var(--pink-cream)] pt-32 pb-12 border-t border-white\" data-kid=\"8\">\n  <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"8-0\">\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 mb-24\" data-kid=\"8-0-0\">\n      <div class=\"lg:col-span-1\" data-kid=\"8-0-0-0\">\n        <a href=\"#\" class=\"font-editorial font-bold text-3xl tracking-tight mb-8 block\" data-kid=\"8-0-0-0-0\">\n          INK<span class=\"text-[var(--rose-deep)]\" data-kid=\"8-0-0-0-0-0\">SPIRED</span>\n        </a>\n        <p class=\"text-gray-500 leading-relaxed mb-8\" data-kid=\"8-0-0-0-1\">\n          Crafting moments of inspiration since 2026. Every pen tells a story. What will yours be?\n        </p>\n        <div class=\"flex items-center gap-4\" data-kid=\"8-0-0-0-2\">\n          <a href=\"#\" class=\"w-10 h-10 glass-panel rounded-full flex items-center justify-center text-gray-700 hover:bg-[var(--rose-deep)] hover:text-white transition-all\" data-kid=\"8-0-0-0-2-0\">\n            <i class=\"ti ti-brand-instagram\" data-kid=\"8-0-0-0-2-0-0\"></i>\n          </a>\n          <a href=\"#\" class=\"w-10 h-10 glass-panel rounded-full flex items-center justify-center text-gray-700 hover:bg-[var(--rose-deep)] hover:text-white transition-all\" data-kid=\"8-0-0-0-2-1\">\n            <i class=\"ti ti-brand-facebook\" data-kid=\"8-0-0-0-2-1-0\"></i>\n          </a>\n          <a href=\"#\" class=\"w-10 h-10 glass-panel rounded-full flex items-center justify-center text-gray-700 hover:bg-[var(--rose-deep)] hover:text-white transition-all\" data-kid=\"8-0-0-0-2-2\">\n            <i class=\"ti ti-brand-messenger\" data-kid=\"8-0-0-0-2-2-0\"></i>\n          </a>\n          <a href=\"#\" class=\"w-10 h-10 glass-panel rounded-full flex items-center justify-center text-gray-700 hover:bg-[var(--rose-deep)] hover:text-white transition-all\" data-kid=\"8-0-0-0-2-3\">\n            <i class=\"ti ti-lock\" data-kid=\"8-0-0-0-2-3-0\"></i>\n          </a>\n        </div>\n      </div>\n      \n      <div data-kid=\"8-0-0-1\">\n        <h4 class=\"font-bold mb-8 uppercase tracking-widest text-xs\" data-kid=\"8-0-0-1-0\">Instruments</h4>\n        <ul class=\"space-y-4\" data-kid=\"8-0-0-1-1\">\n          <li data-kid=\"8-0-0-1-1-0\"><a href=\"#\" class=\"text-gray-500 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"8-0-0-1-1-0-0\">Fountain Pens</a></li>\n          <li data-kid=\"8-0-0-1-1-1\"><a href=\"#\" class=\"text-gray-500 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"8-0-0-1-1-1-0\">Ballpoint Pens</a></li>\n          <li data-kid=\"8-0-0-1-1-2\"><a href=\"#\" class=\"text-gray-500 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"8-0-0-1-1-2-0\">Gel Ink Series</a></li>\n          <li data-kid=\"8-0-0-1-1-3\"><a href=\"#\" class=\"text-gray-500 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"8-0-0-1-1-3-0\">Special Editions</a></li>\n        </ul>\n      </div>\n\n      <div data-kid=\"8-0-0-2\">\n        <h4 class=\"font-bold mb-8 uppercase tracking-widest text-xs\" data-kid=\"8-0-0-2-0\">Maison</h4>\n        <ul class=\"space-y-4\" data-kid=\"8-0-0-2-1\">\n          <li data-kid=\"8-0-0-2-1-0\"><a href=\"#\" class=\"text-gray-500 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"8-0-0-2-1-0-0\">Our Process</a></li>\n          <li data-kid=\"8-0-0-2-1-1\"><a href=\"#\" class=\"text-gray-500 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"8-0-0-2-1-1-0\">The Heritage</a></li>\n          <li data-kid=\"8-0-0-2-1-2\"><a href=\"#\" class=\"text-gray-500 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"8-0-0-2-1-2-0\">Bespoke Services</a></li>\n          <li data-kid=\"8-0-0-2-1-3\"><a href=\"#\" class=\"text-gray-500 hover:text-[var(--rose-deep)] transition-colors\" data-kid=\"8-0-0-2-1-3-0\">Care Guide</a></li>\n        </ul>\n      </div>\n\n      <div data-kid=\"8-0-0-3\">\n        <h4 class=\"font-bold mb-8 uppercase tracking-widest text-xs\" data-kid=\"8-0-0-3-0\">Inquiries</h4>\n        <p class=\"text-gray-500 mb-4\" data-kid=\"8-0-0-3-1\">concierge@inkspired.luxury</p>\n        <p class=\"text-gray-500 mb-8\" data-kid=\"8-0-0-3-2\">+1 800 INKSPIRED</p>\n        <div class=\"p-6 glass-panel rounded-3xl\" data-kid=\"8-0-0-3-3\">\n          <p class=\"text-[10px] font-bold text-gray-400 mb-2 uppercase tracking-tighter\" data-kid=\"8-0-0-3-3-0\">Status</p>\n          <div class=\"flex items-center gap-2\" data-kid=\"8-0-0-3-3-1\">\n            <span class=\"w-2 h-2 bg-emerald-400 rounded-full animate-pulse\" data-kid=\"8-0-0-3-3-1-0\"></span>\n            <span class=\"text-sm font-medium\" data-kid=\"8-0-0-3-3-1-1\">Boutique Open</span>\n          </div>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"pt-12 border-t border-white/50 flex flex-col md:flex-row justify-between items-center gap-6\" data-kid=\"8-0-1\">\n      <p class=\"text-gray-400 text-sm\" data-kid=\"8-0-1-0\">© 2026 INKSPIRED Luxury. All rights reserved.</p>\n      <div class=\"flex gap-8 text-sm text-gray-400\" data-kid=\"8-0-1-1\">\n        <a href=\"#\" class=\"hover:text-[var(--rose-deep)]\" data-kid=\"8-0-1-1-0\">Privacy</a>\n        <a href=\"#\" class=\"hover:text-[var(--rose-deep)]\" data-kid=\"8-0-1-1-1\">Terms</a>\n        <a href=\"#\" class=\"hover:text-[var(--rose-deep)]\" data-kid=\"8-0-1-1-2\">Cookie Policy</a>\n      </div>\n    </div>\n  </div>\n</footer>\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\" data-kid=\"9\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js\" data-kid=\"10\"></script>\n\n<script data-kid=\"11\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Mouse follow logic\n  const glow = document.getElementById('mouseGlow');\n  document.addEventListener('mousemove', (e) => {\n    gsap.to(glow, {\n      duration: 0.8,\n      left: e.clientX,\n      top: e.clientY,\n      ease: 'power3.out'\n    });\n  });\n\n  // Hero Parallax\n  gsap.utils.toArray('.parallax-img').forEach(img => {\n    const speed = img.getAttribute('data-speed');\n    gsap.to(img, {\n      y: (index, target) => -window.innerHeight * speed,\n      scrollTrigger: {\n        trigger: img,\n        start: 'top bottom',\n        end: 'bottom top',\n        scrub: 1\n      }\n    });\n  });\n\n  // Reveal animations\n  gsap.from('#frosted-panel', {\n    duration: 1.5,\n    y: 100,\n    opacity: 0,\n    scale: 0.9,\n    ease: 'expo.out',\n    delay: 0.2\n  });\n\n  gsap.utils.toArray('.glass-card').forEach((card, i) => {\n    gsap.from(card, {\n      scrollTrigger: {\n        trigger: card,\n        start: 'top 85%'\n      },\n      duration: 1,\n      y: 60,\n      opacity: 0,\n      delay: i % 3 * 0.1,\n      ease: 'power4.out'\n    });\n  });\n\n  gsap.from('.reveal-content', {\n    scrollTrigger: {\n      trigger: '.reveal-content',\n      start: 'top 80%'\n    },\n    duration: 1.2,\n    x: -50,\n    opacity: 0,\n    ease: 'power3.out'\n  });\n\n  gsap.from('.reveal-media', {\n    scrollTrigger: {\n      trigger: '.reveal-media',\n      start: 'top 80%'\n    },\n    duration: 1.2,\n    x: 50,\n    opacity: 0,\n    ease: 'power3.out'\n  });\n\n  // Navbar background change on scroll\n  window.addEventListener('scroll', () => {\n    const nav = document.getElementById('pill-nav');\n    if (window.scrollY > 50) {\n      nav.classList.add('bg-white/80');\n      nav.classList.remove('bg-white/20');\n    } else {\n      nav.classList.remove('bg-white/80');\n      nav.classList.add('bg-white/20');\n    }\n  });\n\n  // Category Filtering Demo logic\n  document.querySelectorAll('.tab').forEach(tab => {\n    tab.addEventListener('click', () => {\n      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active', 'bg-[var(--rose-deep)]', 'text-white', 'shadow-lg'));\n      document.querySelectorAll('.tab').forEach(t => t.classList.add('bg-white', 'text-gray-600'));\n      \n      tab.classList.add('active', 'bg-[var(--rose-deep)]', 'text-white', 'shadow-lg');\n      tab.classList.remove('bg-white', 'text-gray-600');\n      \n      const cat = tab.getAttribute('data-cat');\n      document.querySelectorAll('.product-item').forEach(item => {\n        if (cat === 'All' || item.getAttribute('data-cat') === cat) {\n          gsap.to(item, { duration: 0.4, scale: 1, opacity: 1, display: 'block' });\n        } else {\n          gsap.to(item, { duration: 0.4, scale: 0.9, opacity: 0, display: 'none' });\n        }\n      });\n    });\n  });\n</script>",
